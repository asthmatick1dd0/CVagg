# backend/Dockerfile.debug
FROM golang:alpine

WORKDIR /app

# Установка зависимостей
RUN apk add --no-cache \
  git \
  gcc \
  musl-dev \
  ca-certificates

# Настройка окружения
ENV GOPATH=/go
ENV PATH=$PATH:$GOPATH/bin
ENV CGO_ENABLED=1

# Установка Delve (используем @latest)
RUN go install github.com/go-delve/delve/cmd/dlv@latest

# Копируем зависимости
COPY go.mod go.sum ./
RUN go mod download

# Копируем весь код
COPY . .

# Собираем бинарник для отладки
RUN go build -gcflags="all=-N -l" -o /app/main ./cmd

# Проверка что собралось
RUN ls -lah /app/main && echo "✓ Build successful"

EXPOSE 8080 2345

# Запускаем через Delve
CMD ["dlv", "exec", "/app/main", "--headless", "--listen=:2345", "--api-version=2", "--accept-multiclient", "--log"]
